{
  "specDir": "specs",
  "srcDirs": [
    "src",
    "tests",
    "e2e"
  ],
  "testFilePattern": "\\.(test|spec)\\.[cm]?[jt]sx?$",
  "ignore": [
    "node_modules",
    ".git",
    "dist",
    "build",
    ".next",
    "coverage"
  ],
  "baseRef": "origin/main",
  "codeExtensions": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "mjs",
    "cjs"
  ]
}
